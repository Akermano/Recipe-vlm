# Версия проекта через Groq API.
# Получите бесплатный или тестовый API-ключ в console.groq.com

PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Можно задать отдельную текстовую модель для рецептов,
# но по умолчанию используется та же модель, что и для распознавания.
GROQ_RECIPE_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
